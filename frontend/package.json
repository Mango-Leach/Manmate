{
    "name": "stress-relief-chat",
    "version": "1.0.0",
    "private": true,
    "scripts": {
        "dev": "next dev -p 3000",
        "dev:backend": "npm --prefix ../backend run dev",
        "dev:all": "node ../scripts/dev.js",
        "build": "next build --webpack",
        "start": "next start",
        "start:standalone": "next start",
        "lint": "next lint",
        "tunnel:frontend": "ngrok http 3000 --subdomain=stressrelief-fe-local",
        "tunnel:backend": "cd ..\\backend && npm run tunnel"
    },
    "dependencies": {
        "@elevenlabs/react": "^1.6.5",
        "@hookform/resolvers": "^5.2.2",
        "clsx": "^2.1.1",
        "date-fns": "^4.1.0",
        "framer-motion": "^12.31.0",
        "jwt-decode": "^4.0.0",
        "mongodb": "^7.0.0",
        "next": "^16.4.6",
        "next-pwa": "^3.1.5",
        "react": "^18.2.0",
        "react-dom": "^18.2.0",
        "react-hook-form": "^7.71.1",
        "react-hot-toast": "^2.6.0",
        "react-icons": "^4.12.0",
        "react-window": "^2.2.6",
        "recharts": "^3.7.0",
        "socket.io-client": "^4.8.3",
        "zod": "^4.3.6"
    },
    "devDependencies": {
        "@types/node": "^20.10.6",
        "@types/react": "^18.2.46",
        "@types/react-dom": "^18.2.18",
        "@typescript-eslint/eslint-plugin": "^6.15.0",
        "@typescript-eslint/parser": "^6.15.0",
        "autoprefixer": "^10.4.16",
        "eslint": "^8.57.0",
        "eslint-config-next": "^16.4.6",
        "local-ssl-proxy": "^2.0.5",
        "ngrok": "^4.3.3",
        "postcss": "^8.4.32",
