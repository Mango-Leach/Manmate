# ============================================================
# Frontend production environment — mannmate.com
# ------------------------------------------------------------
# Copy to frontend/.env.production on the VPS and fill in real values:
#   cp frontend/.env.production.example frontend/.env.production
# Next.js reads .env.production automatically during `npm run build`
# and `next start`. The real file is git-ignored — never commit secrets.
#
# IMPORTANT: NEXT_PUBLIC_* values are inlined at BUILD time and exposed to
# the browser. If you change one, you must rebuild (npm run build).
# ============================================================

NODE_ENV=production

# Same-domain deployment: the API is reverse-proxied under the site domain,
# so the API base IS the site root (Nginx routes /api and /socket.io to the backend).
NEXT_PUBLIC_API_URL=https://mannmate.com

# Canonical public URL of this site — used for SEO (sitemap, robots, canonical, OG tags).
NEXT_PUBLIC_SITE_URL=https://mannmate.com

# --- Google OAuth ---
# The public client id is safe to expose; the secret is server-side only.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# --- Sarvam AI ---
# Powers the AI Companion voice calls (STT + TTS + Chat). Server-side only.
SARVAM_API_KEY=your_sarvam_api_key
