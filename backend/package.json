{
    "name": "stressrelief-backend",
    "version": "1.0.0",
    "description": "Backend API server for StressReliefChat",
    "main": "server.js",
    "scripts": {
        "dev": "nodemon server.js",
        "start": "node server.js",
        "test": "echo \"Tests not configured yet\" && exit 0",
        "lint": "eslint . --ext .js",
        "lint:fix": "eslint . --ext .js --fix",
        "logs": "tail -f logs/combined-*.log",
        "set-admin": "node set-admin.js",
        "seed:demo-therapists": "node seed-demo-therapists.js",
        "tunnel": "ngrok http 5000 --subdomain=stressrelief-local"
    },
    "keywords": [
        "api",
        "backend",
        "express"
    ],
    "author": "",
    "license": "ISC",
    "dependencies": {
        "axios": "^1.13.5",
        "bcryptjs": "^3.0.3",
        "cors": "^2.8.5",
        "dotenv": "^16.3.1",
        "express": "^4.18.2",
        "express-rate-limit": "^8.2.1",
        "express-validator": "^7.3.1",
        "googleapis": "^171.4.0",
        "helmet": "^8.1.0",
        "joi": "^18.0.2",
        "jsonwebtoken": "^9.0.3",
        "mongodb": "^7.0.0",
        "ngrok": "^5.0.0-beta.2",
        "node-cron": "^4.2.1",
        "nodemailer": "^10.5.0",
        "passport": "^0.7.0",
        "passport-google-oauth20": "^2.0.0",
        "razorpay": "^2.9.6",
        "socket.io": "^4.5.4",
        "winston": "^3.19.0",
        "winston-daily-rotate-file": "^5.0.0"
    },
    "devDependencies": {
        "eslint": "^9.0.0",
        "nodemon": "^3.0.2"
    },
    "engines": {
        "node": ">=18.0.0"
    }
}
