# Copy to .env for local backend development and replace placeholders.
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:5000

# Google OAuth web client. Add both callback URIs below to Authorized redirect
# URIs in Google Cloud Console for this same client ID.
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback
GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:3000/therapist

# MongoDB Atlas connection string. The backend needs a working database to log in.
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/stressrelief
JWT_SECRET=replace-with-a-long-random-secret

# Optional integrations
# Elastic Email REST API (recommended on Render Free; API key needs SendHttp access).
# EMAIL_FROM must be a sender address verified in Elastic Email.
ELASTIC_EMAIL_API_KEY=
EMAIL_FROM=
# SMTP fallback for local/dev or paid hosts that allow SMTP egress.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
FAST2SMS_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
